# Set these in the mandate-ollie-software Vercel project, then redeploy.
# For local use, copy to .env.local (gitignored). Never paste real keys here.
OPENAI_API_KEY=
# Choose a private random access code of 16–256 characters. Enter it in the demo UI.
MANDATE_DEMO_CODE=
# Optional. Default matches the existing marketing app's model.
OPENAI_MODEL=gpt-4o-mini
