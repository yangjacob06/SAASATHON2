# Copy to .env.local and fill in for production. Everything is optional in
# development — Mandate runs with no external services configured at all:
# a local SQLite database, a deterministic (non-AI) deal summary generator,
# and shared fee information sourced from the app configuration.

# Postgres (Supabase, etc). Leave unset to use the local SQLite file at .data/dev.db.
DATABASE_URL=

# OpenAI — powers "Generate deal summary" from the uploaded PDFs + form fields.
# Leave unset to fall back to a deterministic summary built from the form fields alone.
OPENAI_API_KEY=

# Public site URL, used for metadata and application links.
APP_URL=http://localhost:3310

# Exact email allowed to review and activate lender partner accounts.
MANDATE_ADMIN_EMAIL=
