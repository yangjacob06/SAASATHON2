# The default local server binds only to 127.0.0.1 and accepts synthetic data.
PORT=4310
AUTH_MODE=demo
DATA_DIR=
# Optional hosted PostgreSQL; omit to use on-disk embedded PostgreSQL locally.
DATABASE_URL=
# For real authentication, set AUTH_MODE=supabase and provide these values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:4310
# Use NODE_ENV=production, HTTPS and the deployment guide for hosted operation.
